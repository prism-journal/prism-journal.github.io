# dev-only: sharp is needed to regenerate og.png, never shipped
# No trailing slash: that form matches directories only, and a symlink is a
# file. One pointing outside the repo makes every GitHub Pages build fail.
node_modules
package-lock.json
# build intermediate; og.png is the artefact the site actually serves
og.svg

# Reference material from other publishers — study locally, never redistribute.
# These are third-party copyrighted PDFs; publishing them from this repo would
# be republication, not fair use.
TheLancet.com_*/
reference/
*.pdf

# fixture used to preview the article design; never published, because a
# fabricated paper on a real journal's site reads as a real one
preview-article.html
preview-article.pdf
.DS_Store

# preview artefacts — generated, never published
preview-*.html
PRISM-*.pdf
